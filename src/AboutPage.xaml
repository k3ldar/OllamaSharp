<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OllamaSharp.AboutPage"
             Title="About">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="About OllamaSharp"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>

            <Image Source="logo.png"
                   HeightRequest="150"
                   WidthRequest="150"
                   HorizontalOptions="Center"
                   Aspect="AspectFit"/>

            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="15"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="10">
                    <Label Text="OllamaSharp"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Version 1.0.0"
                           HorizontalTextAlignment="Center"
                           TextColor="Gray"/>
                    <BoxView HeightRequest="1"
                             Color="LightGray"
                             Margin="0,10"/>
                    <Label Text="A chat client for Ollama"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="15"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Links"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label Text="&#xE774;"
                               FontFamily="FluentSystemIcons"
                               FontSize="20"
                               TextColor="{DynamicResource Primary}"
                               VerticalOptions="Center"/>
                        <Label Text="GitHub Repository"
                               FontSize="14"
                               TextColor="{DynamicResource Primary}"
                               TextDecorations="Underline"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGitHubTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label Text="&#xE814;"
                               FontFamily="FluentSystemIcons"
                               FontSize="20"
                               TextColor="{DynamicResource Primary}"
                               VerticalOptions="Center"/>
                        <Label Text="Report Issues"
                               FontSize="14"
                               TextColor="{DynamicResource Primary}"
                               TextDecorations="Underline"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnIssuesTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="© 2026 Si Carter"
                   HorizontalTextAlignment="Center"
                   TextColor="Gray"
                   FontSize="12"
                   Margin="0,20,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
