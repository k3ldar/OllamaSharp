<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OllamaSharp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:OllamaSharp"
    Title="OllamaSharp"
    FlyoutBackgroundColor="#F5F5F5">

    <!-- MainPage - not shown in flyout but needed for routing -->
    <ShellContent Title="Chat"
                  ContentTemplate="{DataTemplate local:MainPage}"
                  Route="MainPage"
                  FlyoutItemIsVisible="False" />

    <FlyoutItem Title="Settings">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="⚙️" FontFamily="{OnPlatform WinUI=Segoe UI Emoji}" Size="24"/>
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}"
                      Route="SettingsPage" />
    </FlyoutItem>

    <FlyoutItem Title="About">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="ℹ️" FontFamily="{OnPlatform WinUI=Segoe UI Emoji}" Size="24"/>
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate local:AboutPage}"
                      Route="AboutPage" />
    </FlyoutItem>

    <!-- Custom Flyout Content -->
    <Shell.FlyoutContent>
        <ScrollView>
            <VerticalStackLayout Spacing="0">
                <!-- Flyout Header -->
                <Grid BackgroundColor="#512BD4" 
                      Padding="20"
                      HeightRequest="120">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Image Source="logo.png"
                               HeightRequest="40"
                               WidthRequest="40"
                               Aspect="AspectFit"/>
                        <Label Text="OllamaSharp"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label Text="Powered by magical Unicorns"
                               FontSize="12"
                               TextColor="White"
                               Opacity="0.8"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- New Chat Button -->
                <Grid Padding="16,12" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NewChatCommand}"/>
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="💬" 
                               FontFamily="{OnPlatform WinUI=Segoe UI Emoji}"
                               FontSize="24"
                               VerticalOptions="Center"/>
                        <Label Text="New Chat"
                               FontSize="16"
                               TextColor="#333333"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Settings Button -->
                <Grid Padding="16,12" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToSettingsCommand}"/>
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="⚙️" 
                               FontFamily="{OnPlatform WinUI=Segoe UI Emoji}"
                               FontSize="24"
                               VerticalOptions="Center"/>
                        <Label Text="Settings"
                               FontSize="16"
                               TextColor="#333333"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- About Button -->
                <Grid Padding="16,12" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToAboutCommand}"/>
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="ℹ️" 
                               FontFamily="{OnPlatform WinUI=Segoe UI Emoji}"
                               FontSize="24"
                               VerticalOptions="Center"/>
                        <Label Text="About"
                               FontSize="16"
                               TextColor="#333333"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Separator -->
                <BoxView HeightRequest="1" 
                         BackgroundColor="#E0E0E0" 
                         Margin="16,8"/>

                <Label Text="Recent Chats" 
                       FontSize="12" 
                       FontAttributes="Bold"
                       TextColor="#666666"
                       Margin="16,8,16,4"/>

                <!-- Saved Chats List -->
                <CollectionView ItemsSource="{Binding SavedChats}"
                                SelectionMode="None"
                                Margin="0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="16,8" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:AppShell}}, Path=BindingContext.OpenChatCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>

                                <!-- Chat Title -->
                                <Label Text="{Binding Title}"
                                       Grid.Column="0"
                                       FontSize="14"
                                       TextColor="#333333"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation"/>

                                <!-- Delete Button -->
                                <Button Text="🗑️"
                                        Grid.Column="1"
                                        FontFamily="{OnPlatform WinUI=Segoe UI Emoji}"
                                        BackgroundColor="Transparent"
                                        TextColor="#999999"
                                        FontSize="16"
                                        Padding="8,4"
                                        WidthRequest="40"
                                        HeightRequest="32"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:AppShell}}, Path=BindingContext.DeleteChatCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Shell.FlyoutContent>

</Shell>
