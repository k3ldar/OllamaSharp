name: Build and Release

on:
  push:
    tags:
      - 'v*'  # Triggers on tags like v1.0.0, v2.1.3, etc.

jobs:
  build-android:
    runs-on: windows-latest

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup .NET
      uses: actions/setup-dotnet@v4
      with:
        dotnet-version: '9.0.x'

    - name: Install .NET MAUI workload
      run: dotnet workload install maui

    - name: Restore dependencies
      run: dotnet restore src/OllamaSharp.csproj

    - name: Build and Publish Android APK
      run: dotnet publish src/OllamaSharp.csproj -f net9.0-android -c Release -p:AndroidPackageFormat=apk

    - name: Upload Android APK artifact
      uses: actions/upload-artifact@v4
      with:
        name: android-apk
        path: src/bin/Release/net9.0-android/publish/*.apk
        if-no-files-found: error

  build-windows:
    runs-on: windows-latest

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup .NET
      uses: actions/setup-dotnet@v4
      with:
        dotnet-version: '9.0.x'

    - name: Install .NET MAUI workload
      run: dotnet workload install maui

    - name: Restore dependencies
      run: dotnet restore src/OllamaSharp.csproj

    - name: Build and Publish Windows
      run: dotnet publish src/OllamaSharp.csproj -f net9.0-windows10.0.19041.0 -c Release -p:RuntimeIdentifier=win-x64

    - name: Upload Windows artifact
      uses: actions/upload-artifact@v4
      with:
        name: windows-x64
        path: src/bin/Release/net9.0-windows10.0.19041.0/win-x64/publish/*
        if-no-files-found: error

  build-ios:
    runs-on: macos-latest

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup .NET
      uses: actions/setup-dotnet@v4
      with:
        dotnet-version: '9.0.x'

    - name: Install .NET MAUI workload
      run: dotnet workload install maui

    - name: Restore dependencies
      run: dotnet restore src/OllamaSharp.csproj

    - name: Build iOS (unsigned)
      run: dotnet build src/OllamaSharp.csproj -f net9.0-ios -c Release

    - name: Upload iOS artifact
      uses: actions/upload-artifact@v4
      with:
        name: ios-app
        path: src/bin/Release/net9.0-ios/iossimulator-x64/*
        if-no-files-found: error

  # iOS build temporarily disabled due to Xcode version mismatch in GitHub runners
  # Re-enable when .NET 9 iOS workload is fixed or use self-hosted runner
  # build-ios:
  #   runs-on: macos-latest
  #   steps:
  #   - name: Checkout code
  #     uses: actions/checkout@v4
  #   - name: Setup .NET
  #     uses: actions/setup-dotnet@v4
  #     with:
  #       dotnet-version: '9.0.x'
  #   - name: Install .NET MAUI workload
  #     run: dotnet workload install maui
  #   - name: Restore dependencies
  #     run: dotnet restore src/OllamaSharp.csproj
  #   - name: Build iOS (unsigned)
  #     run: dotnet build src/OllamaSharp.csproj -f net9.0-ios -c Release
  #   - name: Upload iOS artifact
  #     uses: actions/upload-artifact@v4
  #     with:
  #       name: ios-app
  #       path: src/bin/Release/net9.0-ios/iossimulator-x64/*
  #       if-no-files-found: error

  create-release:
    needs: [build-android, build-windows]
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
    - name: Download all artifacts
      uses: actions/download-artifact@v4
      with:
        path: ./artifacts

    - name: Create Release
      uses: softprops/action-gh-release@v2
      with:
        files: |
          artifacts/android-apk/*.apk
          artifacts/windows-x64/*
        draft: false
        prerelease: false
        generate_release_notes: true
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
